# 复制为 .env 后填好，本地启动：set -a; source .env; set +a; node index.js
EDIT_TOKEN=页面里要输入的编辑口令
PORT=8787

# ---- 方式一：MySQL（设了 MYSQL_HOST 就用它）----
MYSQL_HOST=xxx.gaiadb.bj.baidubce.com
MYSQL_PORT=3306
MYSQL_USER=myuser
MYSQL_PASSWORD=密码
MYSQL_DATABASE=dotagame

# ---- 方式二：MongoDB Atlas ----
# MONGODB_URI=mongodb+srv://用户名:密码@cluster0.xxxxx.mongodb.net
# MONGODB_DB=dota

# 本机 DNS 解析不了数据库域名时打开：
# DNS_SERVERS=223.5.5.5,119.29.29.29
