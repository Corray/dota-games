.avatar { width: 120rpx; height: 120rpx; border-radius: 12rpx; margin-right: 20rpx; flex-shrink: 0; }
.pname { font-size: 34rpx; font-weight: 700; }
.b { font-weight: 600; }
.plus { margin-left: 10rpx; font-size: 20rpx; padding: 0 8rpx; border-radius: 6rpx; background: #4a3d20; color: #e0a83a; }
.tile.half { width: calc(50% - 16rpx); }
.secs { white-space: nowrap; margin: 8rpx 0 12rpx; display: flex; flex-direction: row; }
.secs .chip { display: inline-block; margin-right: 12rpx; flex-shrink: 0; }
.chip.sm { padding: 6rpx 16rpx; font-size: 22rpx; }
.th, .tr { display: flex; align-items: center; padding: 10rpx 0; font-size: 24rpx; }
.th { color: #8b93a1; font-size: 22rpx; border-bottom: 1px solid #2a313c; }
.tr { border-bottom: 1px solid #1f252e; }
.th text, .tr text { width: 96rpx; text-align: right; }
.th .w2, .tr .w2 { width: 150rpx; }
.c1 { flex: 1; text-align: left; min-width: 0; overflow: hidden; }
.tr.mine { background: rgba(224, 168, 58, .06); }
.sm { font-size: 20rpx; }
.strip { display: flex; margin: 0 0 16rpx; }
.sq { flex: 1; height: 16rpx; margin: 0 2rpx; border-radius: 3rpx; }
.sq.w { background: #7fb135; } .sq.l { background: #d0463b; }
.side { font-size: 20rpx; padding: 2rpx 8rpx; border-radius: 6rpx; margin-left: 10rpx; }
.side.radiant { background: rgba(127, 177, 53, .15); color: #7fb135; }
.side.dire { background: rgba(208, 70, 59, .15); color: #d0463b; }
.grid { display: flex; flex-wrap: wrap; margin: 8rpx 0 4rpx; font-size: 24rpx; }
.grid > view { width: 50%; padding: 3rpx 0; }
