.pname { font-size: 38rpx; font-weight: 700; }
.bd { margin-bottom: 12rpx; }
.part { display: flex; align-items: center; margin: 10rpx 0; }
.pk { width: 90rpx; color: #8b93a1; font-size: 24rpx; }
.track { flex: 1; height: 14rpx; background: #1d222a; border-radius: 7rpx; overflow: hidden; }
.fill { height: 100%; background: #e0a83a; }
.pv { width: 70rpx; text-align: right; font-size: 24rpx; }
.kv { display: flex; justify-content: space-between; padding: 10rpx 0; border-bottom: 1px solid #1f252e; font-size: 26rpx; }
.spark { display: flex; align-items: flex-end; height: 140rpx; }
.spark .b { flex: 1; margin: 0 2rpx; border-radius: 3rpx 3rpx 0 0; }
.spark .w { background: #7fb135; } .spark .l { background: #d0463b; }
