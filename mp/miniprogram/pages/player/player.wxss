.pname { font-size: 38rpx; font-weight: 700; }
.sv { font-size: 40rpx; font-weight: 700; color: #e0a83a; }
.bd { margin-top: 10rpx; font-size: 26rpx; }
.part { display: flex; align-items: center; margin: 12rpx 0; }
.pk { width: 80rpx; color: #8b93a1; font-size: 24rpx; }
.track { height: 14rpx; background: #1d222a; border-radius: 7rpx; overflow: hidden; }
.fill { height: 100%; background: #e0a83a; }
.ps { font-size: 20rpx; margin-top: 2rpx; }
.pv { width: 60rpx; text-align: right; font-size: 26rpx; }
.pw { width: 90rpx; text-align: right; font-size: 22rpx; }
.cv { width: 100%; height: 360rpx; }
.tip { margin-top: 8rpx; min-height: 36rpx; }
.tiles.in { margin: 0 -8rpx; }
.tiles.in .tile { background: #1d222a; }
.th, .tr { display: flex; padding: 10rpx 0; font-size: 26rpx; }
.th { color: #8b93a1; font-size: 22rpx; border-bottom: 1px solid #2a313c; }
.tr { border-bottom: 1px solid #1f252e; }
.th text, .tr text { width: 110rpx; text-align: right; }
.th .c1, .tr .c1 { flex: 1; text-align: left; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.b { font-weight: 600; }
.ell { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rc { display: flex; align-items: center; padding: 14rpx 0; border-bottom: 1px solid #1f252e; font-size: 26rpx; }
.rc.on { background: #1d222a; }
.side { font-size: 20rpx; padding: 2rpx 8rpx; border-radius: 6rpx; margin-left: 10rpx; }
.side.radiant { background: rgba(127, 177, 53, .15); color: #7fb135; }
.side.dire { background: rgba(208, 70, 59, .15); color: #d0463b; }
.md { background: #1d222a; padding: 12rpx 16rpx 16rpx; border-radius: 0 0 12rpx 12rpx; margin-bottom: 8rpx; }
.teams { display: flex; margin-top: 10rpx; }
.team { flex: 1; min-width: 0; opacity: .75; padding-right: 10rpx; }
.team.won { opacity: 1; }
.tn { font-size: 22rpx; color: #8b93a1; }
.team.won .tn { color: #e0a83a; }
.pl { font-size: 24rpx; margin: 6rpx 0; }
.pl.me { color: #e0a83a; font-weight: 600; }
.chip.act { border-color: #4a3d20; color: #e0a83a; padding: 6rpx 18rpx; font-size: 24rpx; }
