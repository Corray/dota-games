<view class="wrap">
  <view class="err" wx:if="{{err}}">{{err}}（下拉重试）</view>
  <view class="muted" wx:if="{{offline}}">{{offline}}</view>

  <view class="bar">
    <picker range="{{leagueOpts}}" value="{{leagueIdx}}" bindchange="onLeague">
      <view class="chip on">{{leagueOpts[leagueIdx] || '全部联赛'}} ▾</view>
    </picker>
    <picker range="{{mins}}" value="{{minIdx}}" bindchange="onMin">
      <view class="chip">至少 {{mins[minIdx]}} 场 ▾</view>
    </picker>
  </view>

  <view class="tiles">
    <view class="tile" wx:for="{{tiles}}" wx:key="k">
      <view class="k">{{item.k}}</view><view class="v">{{item.v}}</view><view class="s">{{item.s}}</view>
    </view>
  </view>

  <view class="bar">
    <view wx:for="{{sorts}}" wx:key="key" class="chip {{sort === item.key ? 'on' : ''}}" data-k="{{item.key}}" bindtap="onSort">按{{item.label}}</view>
  </view>

  <view class="list">
    <view class="prow" wx:for="{{rows}}" wx:key="pid" data-pid="{{item.pid}}" bindtap="openPlayer">
      <view class="no {{item.no <= 3 ? 'top' : ''}}">{{item.no}}</view>
      <view class="grow">
        <view class="row"><text class="name">{{item.name}}</text><text class="rank">{{item.rank}}</text><text class="bdg">{{item.badges}}</text></view>
        <view class="muted">{{item.g}} 场 · 胜率 {{item.wr}} · Elo {{item.elo}}<text wx:if="{{item.streak}}" class="accent"> · {{item.streak}}</text></view>
      </view>
      <view class="score"><view class="v">{{item.score}}</view><view class="muted">评分</view></view>
    </view>
  </view>
  <view class="more" wx:if="{{rows.length < total}}">上滑加载更多（{{rows.length}} / {{total}}）</view>
  <view class="empty" wx:if="{{!loading && !err && !total}}">这个范围还没有比赛</view>
  <view class="muted" style="text-align:center;margin-top:20rpx">{{updated}} · 下拉刷新</view>
</view>
