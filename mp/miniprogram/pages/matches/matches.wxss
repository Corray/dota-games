.side { font-weight: 600; padding: 2rpx 12rpx; border-radius: 8rpx; font-size: 24rpx; }
.side.radiant { background: rgba(127, 177, 53, .15); color: #7fb135; }
.side.dire { background: rgba(208, 70, 59, .15); color: #d0463b; }
.teams { display: flex; margin-top: 14rpx; }
.team { flex: 1; min-width: 0; padding-right: 12rpx; opacity: .75; }
.team.won { opacity: 1; }
.tname { font-size: 22rpx; color: #8b93a1; margin-bottom: 6rpx; }
.team.won .tname { color: #e0a83a; }
.pl { margin-bottom: 8rpx; }
.pos { display: inline-block; width: 32rpx; height: 32rpx; line-height: 32rpx; text-align: center; border-radius: 6rpx; background: #1d222a; font-size: 20rpx; color: #8b93a1; margin-right: 8rpx; }
.pn { font-size: 26rpx; }
.ph { font-size: 22rpx; padding-left: 40rpx; }
.id { margin-top: 6rpx; font-size: 20rpx; }
