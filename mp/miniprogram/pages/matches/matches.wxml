<view class="wrap">
  <view class="err" wx:if="{{err}}">{{err}}（下拉重试）</view>
  <view class="bar">
    <picker range="{{leagueOpts}}" value="{{leagueIdx}}" bindchange="onLeague">
      <view class="chip on">{{leagueOpts[leagueIdx] || '全部联赛'}} ▾</view>
    </picker>
    <input class="input grow" placeholder="搜选手 / 英雄 / 比赛 ID / 联赛号" value="{{q}}" bindinput="onSearch" confirm-type="search" />
  </view>
  <view class="row between" style="margin-bottom:12rpx"><text class="muted">共 {{total}} 场</text><view class="chip on" bindtap="openImport">＋ 导入比赛</view></view>

  <view class="card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="openMatch">
    <view class="row between">
      <view><text class="side {{item.wcls}}">{{item.winner}}</text><text class="muted"> {{item.date}}<text wx:if="{{item.dur}}"> · {{item.dur}}</text><text wx:if="{{item.score}}"> · {{item.score}}</text></text></view>
      <text class="muted" wx:if="{{item.league}}">联赛 {{item.league}}</text>
    </view>
    <view class="teams">
      <view class="team {{item.rad.won ? 'won' : ''}}">
        <view class="tname">天辉</view>
        <view class="pl" wx:for="{{item.rad.list}}" wx:for-item="s" wx:key="pid" data-pid="{{s.pid}}" catchtap="openPlayer">
          <text class="pos" wx:if="{{s.pos}}">{{s.pos}}</text><text class="pn">{{s.name}}</text>
          <view class="muted ph">{{s.hero}}<text wx:if="{{s.kda}}"> {{s.kda}}</text></view>
        </view>
      </view>
      <view class="team {{item.dire.won ? 'won' : ''}}">
        <view class="tname">夜魇</view>
        <view class="pl" wx:for="{{item.dire.list}}" wx:for-item="s" wx:key="pid" data-pid="{{s.pid}}" catchtap="openPlayer">
          <text class="pos" wx:if="{{s.pos}}">{{s.pos}}</text><text class="pn">{{s.name}}</text>
          <view class="muted ph">{{s.hero}}<text wx:if="{{s.kda}}"> {{s.kda}}</text></view>
        </view>
      </view>
    </view>
    <view class="row between"><text class="muted id">ID {{item.id}}</text><text class="muted id">{{item.replay ? '录像解析 ›' : '详情 ›'}}</text></view>
  </view>
  <view class="more" wx:if="{{items.length < total}}">上滑加载更多（{{items.length}} / {{total}}）</view>
  <view class="empty" wx:if="{{!loading && !err && !total}}">没有符合条件的比赛</view>
  <view class="muted" style="text-align:center;margin-top:20rpx">{{updated}}</view>
</view>
