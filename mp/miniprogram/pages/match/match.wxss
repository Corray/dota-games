.b { font-weight: 600; }
.sm { font-size: 20rpx; }
.side { font-size: 22rpx; padding: 2rpx 10rpx; border-radius: 6rpx; }
.side.radiant { background: rgba(127, 177, 53, .15); color: #7fb135; }
.side.dire { background: rgba(208, 70, 59, .15); color: #d0463b; }
.teams { display: flex; }
.team { flex: 1; min-width: 0; opacity: .75; padding-right: 10rpx; }
.team.won { opacity: 1; }
.tn { font-size: 22rpx; color: #8b93a1; margin-bottom: 6rpx; }
.team.won .tn { color: #e0a83a; }
.pl { font-size: 26rpx; margin-bottom: 8rpx; }
.pos { display: inline-block; min-width: 40rpx; font-size: 20rpx; color: #e0a83a; margin-right: 6rpx; }
.ph { font-size: 22rpx; padding-left: 46rpx; }
.cv { width: 100%; height: 300rpx; }
.cv.sm { height: 220rpx; }
.tipbar { margin-top: 8rpx; font-size: 24rpx; color: #e6e9ef; min-height: 36rpx; }
.th, .tr { display: flex; align-items: center; padding: 8rpx 0; font-size: 22rpx; }
.th { color: #8b93a1; border-bottom: 1px solid #2a313c; }
.tr { border-bottom: 1px solid #1f252e; }
.th text, .tr text { flex: 1; text-align: right; }
.th .c1, .tr .c1 { flex: 1.4; text-align: left; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.tr .n { flex: 0 0 auto; width: 110rpx; }
.lane { margin-top: 10rpx; font-size: 22rpx; color: #e0a83a; }
.dot { display: inline-block; width: 12rpx; height: 12rpx; border-radius: 6rpx; margin-right: 8rpx; }
.dot.radiant { background: #7fb135; } .dot.dire { background: #d0463b; }
.wrapr { flex-wrap: wrap; }
.bpi { font-size: 22rpx; margin: 6rpx 10rpx 6rpx 0; padding: 4rpx 10rpx; border-radius: 6rpx; }
.bpi.radiant { background: rgba(127, 177, 53, .15); color: #9cc65a; }
.bpi.dire { background: rgba(208, 70, 59, .15); color: #e07a70; }
.bpi.ban { opacity: .55; text-decoration: line-through; }
.fstrip { position: relative; height: 90rpx; background: #1d222a; border-radius: 8rpx; margin: 8rpx 0 14rpx; overflow: hidden; }
.kd { position: absolute; bottom: 6rpx; width: 6rpx; height: 6rpx; border-radius: 3rpx; margin-left: -3rpx; }
.kd.radiant { background: #7fb135; } .kd.dire { background: #d0463b; }
.fb { position: absolute; bottom: 0; opacity: .85; border-radius: 3rpx 3rpx 0 0; min-width: 6rpx; }
.fb.radiant { background: #7fb135; } .fb.dire { background: #d0463b; } .fb.even { background: #8b93a1; }
.fr { padding: 10rpx 0; border-bottom: 1px solid #1f252e; font-size: 24rpx; }
.dead { font-size: 22rpx; margin: 4rpx 10rpx 0 0; }
.dead.radiant { color: #7fb135; } .dead.dire { color: #d0463b; }
.win { color: #7fb135; } .lose { color: #d0463b; }
.kr { padding: 8rpx 0; border-bottom: 1px solid #1f252e; font-size: 24rpx; }
.kt { display: inline-block; width: 80rpx; color: #8b93a1; }
